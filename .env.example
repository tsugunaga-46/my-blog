# ローカル開発: WindowsにインストールしたPostgreSQL 16を想定
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/my_portfolio?schema=public"

# 本番(Ubuntu VM / Docker Compose)ではこちらの形式を .env に用意する。
# ホスト名はdocker-compose.ymlのサービス名(db)を指定する。
# DATABASE_URL="postgresql://portfolio:<強力なパスワード>@db:5432/portfolio?schema=public"
# POSTGRES_PASSWORD="<上と同じ強力なパスワード>"
